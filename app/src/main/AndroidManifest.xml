<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      API 37 / Android 17 local-network protection (targetSdk 37+).
      Pre-37: talking to LAN printers, Chromecast, IoT, etc. often only needed INTERNET
      (and maybe CHANGE_WIFI_MULTICAST_STATE / NEARBY_WIFI_DEVICES).
      Targeting 37: local-network sockets are blocked until the user grants this runtime
      permission, OR you use a system-mediated device picker (cast output switcher, etc.).
      ACCESS_LOCAL_NETWORK is in the NEARBY_DEVICES permission group, so a prior grant in
      that group may skip a second prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Still required for remote HTTPS / ECH demos. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Do NOT request READ_CONTACTS for the API 37 system Contacts Picker.
      Pre-37 typical pattern:
          <uses-permission android:name="android.permission.READ_CONTACTS" />
      API 37: ContactsPickerSessionContract.ACTION_PICK_CONTACTS grants a temporary
      session Uri for only the fields/contacts the user selected.
    -->
    <!-- <uses-permission android:name="android.permission.READ_CONTACTS" /> -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Exact allow-while-idle alarms (API 31+ schedule policy still applies). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.UWB_RANGING" />

    <!--
      API 37: apps that talk to the NPU (LiteRT NPU delegate, vendor SDKs, deprecated NNAPI)
      must declare this feature or access can be blocked when targeting 37.
    -->
    <uses-feature
        android:name="android.hardware.neural_processing_unit"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.uwb"
        android:required="false" />

    <application
        android:name=".ApiUpgrade37App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApiUpgrade37"
        android:usesCleartextTraffic="false"
        tools:targetApi="37">

        <!--
          Adaptive-first (targetSdk 37):
          On large screens (sw > 600dp) the system IGNORES:
            android:screenOrientation
            android:resizeableActivity="false"
            android:minAspectRatio / android:maxAspectRatio
            Activity.setRequestedOrientation()
          Games (Play app category) remain exempt. Phones in desktop/connected-display
          mode are treated as large screens too.

          Pre-37 you could still lock portrait like this (DO NOT rely on it after targeting 37):
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:maxAspectRatio="2.4"
        -->
        <!--
          Activity recreation default change (API 37):
          Keyboard, keyboardHidden, navigation, touchscreen, and colorMode no longer
          recreate the Activity by default. You get onConfigurationChanged() instead.
          To OPT BACK IN to the old restart behavior, set recreateOnConfigChanges,
          and do NOT also list those flags in configChanges (configChanges wins).

          Example opt-in (commented — this sample wants the new smooth default):
            android:recreateOnConfigChanges="keyboard|keyboardHidden|navigation|touchscreen|colorMode"
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ApiUpgrade37"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".jobs.DebugSampleJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
